# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.
# Los valores de ejemplo de desarrollo están en el comentario de cada bloque.

NODE_ENV=development
PORT=8787
# Origen del frontend (CORS y redirecciones de Stripe)
APP_URL=http://localhost:4300
# URL pública de esta API (para las URLs firmadas del almacén local)
PUBLIC_API_URL=http://localhost:8787
# 1 = este proceso también ejecuta el trabajador (cola, cron). En producción, un proceso aparte.
RUN_WORKER=1

# ---- Base de datos
# Local: postgres://postgres:postgres@localhost:54329/my3dstudio   (npm run db:local)
# Supabase: Project Settings → Database → Connection string (modo "session", región UE). En producción añade ?sslmode=require
DATABASE_URL=

# ---- Auth (Supabase Auth)
# Desarrollo sin Supabase: LOCAL_AUTH=1 y un LOCAL_JWT_SECRET aleatorio de 32+ caracteres.
LOCAL_AUTH=0
LOCAL_JWT_SECRET=
# Supabase: Project Settings → API
SUPABASE_URL=
# Solo si tu proyecto usa el "JWT secret" heredado (HS256). Los proyectos nuevos usan claves asimétricas (JWKS) y no lo necesitan.
SUPABASE_JWT_SECRET=
# Solo servidor: para borrar usuarios al borrar la cuenta. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Archivos
# local (desarrollo) o r2 (producción)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Secreto aleatorio de 32+ caracteres para firmar URLs del almacén local
FILE_URL_SECRET=
# Cloudflare R2: R2 → Manage API tokens (permiso Object Read & Write sobre un bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Pagos (Stripe, MODO TEST: claves sk_test_ hasta /replica-deploy)
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:8787/api/webhooks/stripe  → imprime el whsec_ de pruebas
STRIPE_WEBHOOK_SECRET=
# Ids de precio (price_...) de los productos que crees en el panel de Stripe; `npm run seed` los enlaza
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_MONTH=
STRIPE_PRICE_MAX_YEAR=
# Packs de créditos (pago único, sin caducidad)
STRIPE_PRICE_PACK_150=
STRIPE_PRICE_PACK_800=
STRIPE_PRICE_PACK_2600=
STRIPE_PRICE_PACK_9000=

# ---- Email (Resend, desde tu dominio verificado)
# console = no envía nada (desarrollo)
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=My3DStudio <hola@tudominio.com>

# ---- Motor 3D
# fake = objetos procedurales (solo desarrollo) · fal = TRELLIS.2 en fal.ai (y FLUX.1 schnell para texto a 3D)
GENERATION_PROVIDER=fake
# fal.ai → Dashboard → API Keys. Solo en el servidor.
FAL_KEY=
# Tope de generaciones simultáneas en el proveedor (fal cobra por llamada; esto limita también el gasto)
PROVIDER_MAX_CONCURRENCY=4
# Freno de gasto: máximo de generaciones al día (UTC); las demás esperan al día siguiente. 0 = sin tope (≈ 0,28 € cada una)
GENERATION_DAILY_LIMIT=20
# Vista previa antes de pagar (solo la imagen de un texto, ~0,003 € con fal): tope por persona y día
PREVIEW_DAILY_LIMIT=30

# ---- Coste en créditos (tarifa de lanzamiento: replica/launch/pricing.md)
# Con fal cada modelo cuesta ~0,28 €; 50 créditos ≈ 0,50-0,63 € según plan o pack
CREDITS_HD=50
CREDITS_TEXTURE_4K=10
CREDITS_TEXTURE_8K=20
CREDITS_SMART_PER_VARIANT=50
# Ruta a Blender para exportar FBX, USDZ y 3MF (opcional en desarrollo)
BLENDER_PATH=
