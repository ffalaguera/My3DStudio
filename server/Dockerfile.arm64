# API y trabajador de My3DStudio para servidores ARM64 (Oracle Cloud Always Free, Ampere A1).
# Blender no publica versión oficial para Linux ARM: se usa el paquete de Ubuntu 24.04 (Blender 4.0, con FBX y USD).
# Node 24 se copia de su imagen oficial. Construir en el propio servidor ARM:
#   docker compose -f deploy/oracle/docker-compose.yml build
FROM node:24.12.0-bookworm-slim AS node

FROM ubuntu:24.04

# Node (binario + npm) de la imagen oficial
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && node --version && npm --version

# Blender sin interfaz (solo para convertir a FBX y USDZ) y certificados para HTTPS saliente
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates blender \
  && rm -rf /var/lib/apt/lists/* \
  && blender -b --factory-startup --python-expr "import bpy; print('blender ok', bpy.app.version_string)"

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY tsconfig.json ./
COPY src ./src
COPY migrations ./migrations

ENV NODE_ENV=production \
    PORT=8787 \
    BLENDER_PATH=/usr/bin/blender

# Usuario sin privilegios; /data/storage es el volumen de los modelos (STORAGE_DRIVER=local)
RUN useradd --system --uid 10001 --home /app app && mkdir -p /data/storage && chown -R app /data /app
USER app
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "src/main.ts"]
