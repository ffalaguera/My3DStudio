# Copia este archivo a deploy/oracle/.env.production en el servidor y rellénalo. NUNCA lo subas a git.
# Genera cada secreto aleatorio con:  openssl rand -hex 32
# Guía completa: replica/deploy-oracle.md

# ---- Docker (también lo usa docker-compose.yml)
POSTGRES_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels → tu túnel → token
TUNNEL_TOKEN=

# ---- API
NODE_ENV=production
PORT=8787
APP_URL=https://tudominio.com
PUBLIC_API_URL=https://api.tudominio.com
# La base va por la red interna de Docker (no sale a internet): docker-compose.yml fija DATABASE_URL.

# ---- Acceso propio (sin Supabase)
AUTH_PROVIDER=self
BETTER_AUTH_SECRET=
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente de OAuth (aplicación web).
# Orígenes autorizados: https://tudominio.com. Déjalos vacíos para entrar solo con email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Archivos en el disco del servidor (volumen «storage»)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/data/storage
FILE_URL_SECRET=

# ---- Email (Resend, gratis hasta 3.000/mes; dominio verificado en Resend)
EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM=My3DStudio <hola@tudominio.com>

# ---- Motor 3D (fal.ai). Sin auto-recarga en fal: el saldo es tu tope de gasto.
GENERATION_PROVIDER=fal
FAL_KEY=
PROVIDER_MAX_CONCURRENCY=4
# Freno de gasto: máximo de generaciones al día (≈ 0,28 € cada una). 20 ≈ 5,60 € como máximo al día.
GENERATION_DAILY_LIMIT=20

# ---- Pagos (Stripe). Vacío = pagos apagados (la web lo indica). En producción, claves sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_MONTH=
STRIPE_PRICE_MAX_YEAR=
STRIPE_PRICE_PACK_150=
STRIPE_PRICE_PACK_800=
STRIPE_PRICE_PACK_2600=
STRIPE_PRICE_PACK_9000=
